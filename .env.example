# Supabase PostgreSQL JDBC URL must use certificate and hostname verification.
# Never commit real connection details or the service-role key.
SUPABASE_DB_URL=jdbc:postgresql://db.PROJECT.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=C%3A%5Cpath%5Cto%5Csupabase-ca.crt&currentSchema=manage-receipt
SUPABASE_DB_USERNAME=
SUPABASE_DB_PASSWORD=
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
AWS_REGION=us-east-2
AWS_S3_BUCKET=manage-recipt-s3-365513553621-us-east-2-an
AWS_PROFILE=manage-invoice
# Configure this SSO profile locally with `aws configure sso --profile manage-invoice`.

# Public frontend configuration. Never use the service-role key here.
VITE_SUPABASE_URL=https://PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_PROXY_TARGET=http://127.0.0.1:8094

# Stripe configuration. Secret and webhook keys are server-side only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_FREE_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=

# Optional local receipt extraction.
OCR_TESSERACT_COMMAND=tesseract
RECEIPT_AI_ENABLED=false
RECEIPT_AI_PORT=11435
RECEIPT_AI_MODEL=qwen2.5vl:3b
